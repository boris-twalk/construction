{
  "name": "crane-lift-planning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "npm run test:engineering && npm run test:db && npm run test:api",
    "db:init": "node scripts/init-db.mjs",
    "review:server": "node server/start-review.mjs",
    "review:prepare": "node scripts/prepare-review.mjs && python3 scripts/render-review-pages.py",
    "test:engineering": "vitest run",
    "test:db": "node tests/review-db.test.mjs",
    "test:api": "node tests/review-api.test.mjs",
    "test:private": "node scripts/test-private.mjs",
    "typecheck": "tsc -b --pretty false",
    "review:demo": "REVIEW_DATA_MODE=synthetic node server/start-review.mjs",
    "review:render": "python3 scripts/render-review-pages.py"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  }
}
