{
  "name": "crane-lift-planning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run && node server/review.test.mjs",
    "db:init": "node scripts/init-db.mjs",
    "review:server": "python3 scripts/render-review-pages.py && node server/index.mjs",
    "review:prepare": "node scripts/prepare-review.mjs && python3 scripts/render-review-pages.py"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  }
}
